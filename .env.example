# Local curated pipeline / Worker publishing
YOUTUBE_API_KEY=your-youtube-api-key
AUTH_API_URL=http://127.0.0.1:8787
CONTENT_UPLOAD_TOKEN=match-worker-content-upload-token
# Required for approved channels, remote triggering and pipeline status in admin
ADMIN_TOKEN=your-admin-token
# Optional HTTP/HTTPS proxy for local YouTube collection; app proxy is used as fallback.
# PIPELINE_PROXY=http://127.0.0.1:7890

# Only scripts/upload-release.mjs (desktop installer distribution) still uses R2 S3 credentials.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ytensub-curated

# Desktop client only (independent of pipeline AUTH_API_URL).
# Copy these public values to .env.local for development / self-hosted builds.
YTENSUB_API_URL=http://127.0.0.1:8787
# Empty disables update checks, automatic downloads and installer fallback links.
YTENSUB_UPDATE_URL=
