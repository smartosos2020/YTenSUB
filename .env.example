# Local curated pipeline / Worker publishing
YOUTUBE_API_KEY=your-youtube-api-key
AUTH_API_URL=https://ytensub-api.smartosos2020.workers.dev
CONTENT_UPLOAD_TOKEN=match-worker-content-upload-token
# Optional: approved channels and pipeline status in admin
ADMIN_TOKEN=your-production-admin-token

