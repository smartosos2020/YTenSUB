{
  "name": "ytensub",
  "version": "0.1.7",
  "private": true,
  "description": "Desktop YouTube player for English learning: bilingual (EN/ZH) subtitles, subtitle word translation, vocabulary book, favorites",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "lint": "eslint src tests",
    "build:dict": "node scripts/build-dict.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "wink-lemmatizer": "^3.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "build": {
    "appId": "com.ytensub.app",
    "productName": "YTenSUB",
    "files": [
      "out/**",
      "resources/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "smartosos2020",
        "repo": "YTenSUB",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
