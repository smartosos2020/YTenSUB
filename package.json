{
  "name": "ytensub",
  "version": "0.1.17",
  "private": true,
  "description": "Desktop YouTube player for English learning: bilingual (EN/ZH) subtitles, subtitle word translation, vocabulary book, favorites",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/prepare-rqbit.mjs",
    "prebuild": "node scripts/prepare-rqbit.mjs",
    "predist": "node scripts/prepare-rqbit.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "lint": "eslint src tests",
    "build:dict": "node scripts/build-dict.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "dist": "electron-vite build && electron-builder",
    "release": "npm run dist && node scripts/upload-release.mjs",
    "pipeline": "node scripts/content-pipeline.mjs",
    "pipeline:runner": "node scripts/pipeline-runner.mjs",
    "pipeline:runner:start": "node scripts/start-pipeline-runner.mjs"
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mediabunny/ac3": "^1.66.0",
    "@mediabunny/dts": "^1.66.0",
    "@tanstack/react-virtual": "^3.14.26",
    "electron-updater": "^6.8.9",
    "mediabunny": "^1.66.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "wink-lemmatizer": "^3.0.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "undici": "^7.30.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "build": {
    "appId": "com.ytensub.app",
    "productName": "YTenSUB",
    "files": [
      "out/**",
      "resources/**",
      "!resources/engines/**"
    ],
    "extraResources": [
      {
        "from": "resources/engines",
        "to": "engines",
        "filter": [
          "rqbit.exe"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-c1dea26a05844ec7959997061df9f305.r2.dev/releases",
        "channel": "latest"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
