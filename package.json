{
  "name": "ytensub",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop YouTube player for English learning: bilingual (EN/ZH) subtitles, subtitle word translation, vocabulary book, favorites",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "build:dict": "node scripts/build-dict.mjs",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "build": {
    "appId": "com.ytensub.app",
    "productName": "YTenSUB",
    "files": ["out/**", "resources/**"],
    "win": {
      "target": "nsis"
    }
  }
}
