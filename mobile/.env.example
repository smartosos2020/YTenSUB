# Shared client configuration. No production API is selected by default.
# adb reverse tcp:8787 tcp:8787 lets an authorized Android device reach your local Worker.
# Android emulator may instead use http://10.0.2.2:8787; LAN devices need your PC's LAN IP.
EXPO_PUBLIC_YTENSUB_API_URL=http://127.0.0.1:8787
